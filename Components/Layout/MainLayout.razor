@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100 @(modoOscuro ? "bg-dark text-light" : "bg-light text-dark")"
     data-bs-theme="@(modoOscuro ? "dark" : "light")">

    <header class="bg-black text-white shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark container">
            <a class="navbar-brand fw-bold" href="/">TaskMaster Blazor</a>

            <div class="navbar-nav ms-auto d-flex flex-row align-items-center gap-3">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Tablero de Tareas</NavLink>

                <button type="button" class="btn btn-sm btn-outline-light" @onclick="CambiarTema">
                    @(modoOscuro ? "☀️ Modo Claro" : "🌙 Modo Oscuro")
                </button>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @Body
    </main>

    <footer class="border-top py-3 mt-auto text-center small @(modoOscuro ? "bg-dark text-secondary border-secondary" : "bg-white text-muted")">
        <div class="container">
            <span>Gestor de Tareas &copy; 2026 - Desarrollado con Blazor & Bootstrap 5</span>
        </div>
    </footer>
</div>

@code {
    private bool modoOscuro = false;

    private void CambiarTema()
    {
        modoOscuro = !modoOscuro;
    }
}