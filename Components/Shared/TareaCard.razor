@using GestorTareasBlazor.Models

<article class="card h-100 shadow-sm tarea-card @(Tarea.Completada ? "completada" : "")">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge @ObtenerClaseBadge()">@Tarea.Prioridad</span>
            <small class="text-muted">Vence: @Tarea.FechaLimite.ToString("dd/MM/yyyy")</small>
        </div>

        <h3 class="h6 card-title fw-bold @(Tarea.Completada ? "text-decoration-line-through text-muted" : "")">
            @Tarea.Titulo
        </h3>

        <p class="card-text small text-secondary flex-grow-1">@Tarea.Descripcion</p>

        <div class="d-flex flex-wrap gap-1 pt-2 border-top mt-2">
            <button type="button" class="btn btn-sm @(Tarea.Completada ? "btn-outline-secondary" : "btn-success")"
                    @onclick="() => OnAlternarEstado.InvokeAsync(Tarea.Id)">
                @(Tarea.Completada ? "Reabrir" : "Completar")
            </button>

            <button type="button" class="btn btn-sm btn-outline-primary"
                    @onclick="() => OnVerDetalle.InvokeAsync(Tarea.Id)">
                Detalle
            </button>

            <button type="button" class="btn btn-sm btn-outline-dark" title="Copiar con JS"
                    @onclick="() => OnCopiarTexto.InvokeAsync(Tarea)">
                Copiar
            </button>

            <button type="button" class="btn btn-sm btn-outline-danger ms-auto"
                    @onclick="() => OnSolicitarEliminar.InvokeAsync(Tarea)">
                Eliminar
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public TareaItem Tarea { get; set; } = default!;
    [Parameter] public EventCallback<int> OnAlternarEstado { get; set; }
    [Parameter] public EventCallback<int> OnVerDetalle { get; set; }
    [Parameter] public EventCallback<TareaItem> OnCopiarTexto { get; set; }
    [Parameter] public EventCallback<TareaItem> OnSolicitarEliminar { get; set; }

    private string ObtenerClaseBadge() => Tarea.Prioridad switch
    {
        "Alta" => "bg-danger",
        "Media" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };
}