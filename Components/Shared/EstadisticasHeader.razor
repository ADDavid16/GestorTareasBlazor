<section class="stats-banner p-3 p-md-4 rounded-3 mb-4 shadow-sm" aria-label="Resumen de tareas">
    <div class="row text-center g-3">
        <div class="col-4">
            <span class="d-block fs-3 fw-bold">@Total</span>
            <small class="text-uppercase opacity-75">Totales</small>
        </div> 
        <div class="col-4 border-start border-end border-light border-opacity-25">
            <span class="d-block fs-3 fw-bold text-warning">@Pendientes</span>
            <small class="text-uppercase opacity-75">Pendientes</small>
        </div> 
        <div class="col-4">
            <span class="d-block fs-3 fw-bold text-info">@Completadas</span>
            <small class="text-uppercase opacity-75">Completadas</small>
        </div>
    </div>
</section>

@code {
    //
    [Parameter] public int Total { get; set; }
    [Parameter] public int Pendientes { get; set; } 
    [Parameter] public int Completadas { get; set; }
} 