<section class="d-flex flex-column flex-sm-row gap-2 mb-3 justify-content-between align-items-sm-center" aria-label="Filtros">
    <div class="btn-group" role="group">
        <button type="button" class="btn btn-sm @(FiltroEstado == "Todas" ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => CambiarEstado("Todas")'>
            Todas
        </button>
        <button type="button" class="btn btn-sm @(FiltroEstado == "Pendientes" ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => CambiarEstado("Pendientes")'>
            Pendientes
        </button>
        <button type="button" class="btn btn-sm @(FiltroEstado == "Completadas" ? "btn-primary" : "btn-outline-primary")"
                @onclick='() => CambiarEstado("Completadas")'>
            Completadas
        </button>
    </div>

    <select class="form-select form-select-sm w-auto" value="@FiltroPrioridad" @onchange="CambiarPrioridad">
        <option value="Todas">Prioridad: Todas</option>
        <option value="Alta">Alta</option>
        <option value="Media">Media</option>
        <option value="Baja">Baja</option>
    </select>
</section>

@code {
    [Parameter] public string FiltroEstado { get; set; } = "Todas";
    [Parameter] public EventCallback<string> FiltroEstadoChanged { get; set; }

    [Parameter] public string FiltroPrioridad { get; set; } = "Todas";
    [Parameter] public EventCallback<string> FiltroPrioridadChanged { get; set; }

    private Task CambiarEstado(string estado) => FiltroEstadoChanged.InvokeAsync(estado);

    private Task CambiarPrioridad(ChangeEventArgs e) =>
        FiltroPrioridadChanged.InvokeAsync(e.Value?.ToString() ?? "Todas");
}